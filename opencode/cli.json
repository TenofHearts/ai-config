{
  "$schema": "https://opencode.ai/v2/cli.json",
  "theme": {
    "name": "tokyonight",
    "mode": "system"
  },
  "animations": true,
  "cursor": {
    "style": "block",
    "blinking": true
  },
  "mouse": true,
  "prompt": {
    "editor": true,
    "paste": "compact",
    "image_preview": false
  },
  "session": {
    "sidebar": "auto",
    "scrollbar": false,
    "submit_scroll": "bottom",
    "thinking": "hide",
    "grouping": "auto",
    "image_preview": false,
    "tps": true,
    "markdown": "rendered",
    "new_location": "launch",
    "permissions": "prompt"
  },
  "tabs": {
    "mode": "auto",
    "scope": "cwd",
    "layout": "horizontal",
    "indicators": "status"
  },
  "diffs": {
    "source": "working",
    "wrap": "word",
    "tree": true,
    "single": false,
    "view": "auto"
  },
  "terminal": {
    "title": true,
    "copy": "select"
  }
}
